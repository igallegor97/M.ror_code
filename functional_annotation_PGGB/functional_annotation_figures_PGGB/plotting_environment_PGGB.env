#!/usr/bin/env bash

# Functional annotation figure configuration for the PGGB project.

PROJECT_ROOT=/Storage/data1/isabella.gallego/MAESTRIA/code/functional_annotation_PGGB
RESULTS=/Storage/data1/isabella.gallego/MAESTRIA/functional_annotation_PGGB_results

FINAL_MASTER="$RESULTS/07_master/final_integrated/functional_annotation_master_final.tsv"
FIGURE_ROOT="$RESULTS/08_figures"
LOGS="$PROJECT_ROOT/logs"

# Set this after checking `module spider R`. Leave empty if Rscript is already
# available after login.
R_MODULE=

# Optional. When supplied, GO identifiers will be labelled with ontology names.
# Example: GO_OBO=/Storage/databases/GO/go-basic.obo
GO_OBO=

TOP_N=20
SHORT_PROTEIN_THRESHOLD=100
PNG_DPI=300

THREADS=4
MEMORY=24G
RUNTIME=12:00:00

