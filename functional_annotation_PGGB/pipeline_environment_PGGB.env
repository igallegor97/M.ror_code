#!/usr/bin/env bash

# Environment variables for the functional annotation pipeline using PGGB

PROJECT_ROOT=/Storage/data1/isabella.gallego/MAESTRIA/code/functional_annotation_PGGB
SAMPLES_TSV="$PROJECT_ROOT/pacbio_proteomes_manifest_PGGB.tsv"
RESULTS=/Storage/data1/isabella.gallego/MAESTRIA/functional_annotation_PGGB_results
LOGS="$PROJECT_ROOT/logs"

EGGNOG_MODULE=eggnog-mapper/2.1.13
EGGNOG_DATA=/Storage/databases/eggnog-mapper-2.1.13
HMMER_MODULE=Hmmer/3.2.1
PFAM_HMM=/Storage/databases/Pfam/v35/Pfam-A.hmm
DBCAN_ENV=/Storage/progs/run_dbCAN_4.0
DBCAN_DB=/Storage/databases/dbCAN_v5.1.2
SIGNALP_MODULE=signalp/5.0b

THREADS=8
MEMORY=32G
RUNTIME=48:00:00
